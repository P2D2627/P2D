[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/others/debug/sound_room.gd" id="1_script"]
[ext_resource type="SystemFont" path="res://themes/main_font.tres" id="2_font"]

[sub_resource type="Theme" id="Theme_room"]
default_font = ExtResource("2_font")
default_font_size = 30

[node name="SoundRoom" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
