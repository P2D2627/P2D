[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 60

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "Sound room"

[node name="Help" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.78, 1)
text = "Click or Enter: play  ·  arrows: move  ·  type: search  ·  Esc: stop all  ·  a loop stops when pressed again"
