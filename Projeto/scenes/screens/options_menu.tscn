[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/screens/options_menu.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/screens/controls_menu.tscn" id="2_controls_menu"]
[ext_resource type="PackedScene" path="res://scenes/levels/prompt_glyph.tscn" id="3_glyph"]

[node name="OptionsMenu" type="VBoxContainer" groups=["menu_no_crosses"]]
visible = false
theme_type_variation = &"OptionsList"
script = ExtResource("1_script")

[node name="Heading" type="Label" parent="."]
layout_mode = 2
text = "SETTINGS"
horizontal_alignment = 1

[node name="Tabs" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
alignment = 1

[node name="AudioTab" type="Button" parent="Tabs" groups=["menu_no_hover_focus"]]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsTab"
text = "AUDIO"

[node name="DisplayTab" type="Button" parent="Tabs" groups=["menu_no_hover_focus"]]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsTab"
text = "DISPLAY"

[node name="ControlsTab" type="Button" parent="Tabs" groups=["menu_no_hover_focus"]]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsTab"
text = "CONTROLS"

[node name="AccessibilityTab" type="Button" parent="Tabs" groups=["menu_no_hover_focus"]]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsTab"
text = "ACCESSIBILITY"

[node name="Pages" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="AudioPage" type="VBoxContainer" parent="Pages"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsList"

[node name="Volumes" type="GridContainer" parent="Pages/AudioPage"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsGrid"
columns = 3

[node name="DisplayPage" type="VBoxContainer" parent="Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"OptionsList"

[node name="Display" type="GridContainer" parent="Pages/DisplayPage"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsGrid"
columns = 3

[node name="FullscreenLabel" type="Label" parent="Pages/DisplayPage/Display"]
layout_mode = 2
theme_type_variation = &"OptionsLabel"
text = "Full screen"

[node name="FullscreenCheck" type="CheckButton" parent="Pages/DisplayPage/Display"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0

[node name="FullscreenValue" type="Label" parent="Pages/DisplayPage/Display"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsLabel"

[node name="VSyncLabel" type="Label" parent="Pages/DisplayPage/Display"]
layout_mode = 2
theme_type_variation = &"OptionsLabel"
text = "V-Sync"

[node name="VSyncCheck" type="CheckButton" parent="Pages/DisplayPage/Display"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0

[node name="VSyncValue" type="Label" parent="Pages/DisplayPage/Display"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsLabel"

[node name="FpsCapLabel" type="Label" parent="Pages/DisplayPage/Display"]
layout_mode = 2
theme_type_variation = &"OptionsLabel"
text = "Frame rate limit"

[node name="FpsCapOption" type="OptionButton" parent="Pages/DisplayPage/Display"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"OptionsChoice"

[node name="FpsCapValue" type="Label" parent="Pages/DisplayPage/Display"]
layout_mode = 2
theme_type_variation = &"OptionsLabel"

[node name="ControlsMenu" parent="Pages" instance=ExtResource("2_controls_menu")]
unique_name_in_owner = true
layout_mode = 2

[node name="AccessibilityPage" type="VBoxContainer" parent="Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"OptionsList"

[node name="Accessibility" type="GridContainer" parent="Pages/AccessibilityPage"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsGrid"
columns = 3

[node name="Description" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsDescription"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Prompts" type="HBoxContainer" parent="."]
layout_mode = 2
alignment = 1

[node name="ResetButton" type="Button" parent="Prompts"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsPrompt"
text = "RESET TO DEFAULTS"

[node name="BackRow" type="HBoxContainer" parent="Prompts"]
layout_mode = 2
theme_type_variation = &"PromptRow"

[node name="BackGlyph" parent="Prompts/BackRow" instance=ExtResource("3_glyph")]
layout_mode = 2
size_flags_vertical = 4
action = &"ui_cancel"

[node name="BackButton" type="Button" parent="Prompts/BackRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsPrompt"
text = "BACK"
