[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/screens/pause_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://themes/ui_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/screens/options_menu.tscn" id="3_options_menu"]
[ext_resource type="PackedScene" path="res://scenes/screens/menu_backdrop.tscn" id="4_backdrop"]
[ext_resource type="Script" path="res://scenes/screens/menu_crosses.gd" id="5_crosses"]
[ext_resource type="PackedScene" path="res://scenes/screens/menu_feedback.tscn" id="6_feedback"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
visible = false
script = ExtResource("1_script")

[node name="MenuBackdrop" parent="." instance=ExtResource("4_backdrop")]
background_alpha = 0.9

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 3
anchor_left = 0.42
anchor_right = 0.92
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Panel" type="VBoxContainer" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(600, 0)
layout_mode = 2

[node name="Heading" type="Label" parent="Center/Panel"]
visible = false
layout_mode = 2
text = "PAUSED"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Center/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuFirstOption"
text = "RESUME"

[node name="OptionsButton" type="Button" parent="Center/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuOption"
text = "SETTINGS"

[node name="MainMenuButton" type="Button" parent="Center/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuOption"
text = "MAIN MENU"

[node name="OptionsMenu" parent="Center" instance=ExtResource("3_options_menu")]
unique_name_in_owner = true
layout_mode = 2

[node name="Crosses" type="Control" parent="." node_paths=PackedStringArray("menu")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("5_crosses")
menu = NodePath("../Center")

[node name="MenuFeedback" parent="." node_paths=PackedStringArray("menu") instance=ExtResource("6_feedback")]
menu = NodePath("..")
