[node name="GymHint" parent="." instance=ExtResource("1_hint")]
position = Vector2(90, 360)
text = "Parede e chaminé
Salta contra a parede e empurra: deslizas, e continuas a deslizar sem segurar. Sozinha, a parede não se sobe.
Chaminé: salta lá para dentro contra uma parede; daí para cima basta carregar no salto, sem direção, até ao topo."

