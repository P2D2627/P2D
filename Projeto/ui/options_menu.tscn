[gd_scene format=3]

[ext_resource type="Script" path="res://ui/options_menu.gd" id="1_script"]

[node name="OptionsMenu" type="VBoxContainer"]
visible = false
script = ExtResource("1_script")

[node name="Heading" type="Label" parent="."]
layout_mode = 2
text = "Options"
horizontal_alignment = 1

[node name="Volumes" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
columns = 3

[node name="FullscreenCheck" type="CheckButton" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Full screen"

[node name="VSyncCheck" type="CheckButton" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "V-Sync"

[node name="FpsCapRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="FpsCapLabel" type="Label" parent="FpsCapRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Frame rate limit"

[node name="FpsCapOption" type="OptionButton" parent="FpsCapRow"]
unique_name_in_owner = true
layout_mode = 2

[node name="ResetButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Reset to defaults"

[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Back"
