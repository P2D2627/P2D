[node name="OptionsButton" type="Button" parent="Center/MainPanel"]
unique_name_in_owner = true
layout_mode = 2
text = "Options"

[node name="QuitButton" type="Button" parent="Center/MainPanel"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"

[node name="LevelPanel" type="VBoxContainer" parent="Center"]
unique_name_in_owner = true
