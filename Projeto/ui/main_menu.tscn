[gd_scene format=3]

[ext_resource type="Script" path="res://ui/main_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/ui_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://ui/options_menu.tscn" id="3_options_menu"]

[node name="MainMenu" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="MainPanel" type="VBoxContainer" parent="Center"]
